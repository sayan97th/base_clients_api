APP_NAME="BASE Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set to "mailtrap" or "mailpit" for local/testing, "mailgun" for production
MAIL_MAILER=mailtrap
MAIL_FROM_ADDRESS="noreply@basesearchmarketing.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap — local development and testing
MAILTRAP_SMTP_HOST=smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_ENCRYPTION=tls
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=

# Mailpit — local development (https://mailpit.axllent.org)
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_ENCRYPTION=
MAILPIT_SMTP_USERNAME=
MAILPIT_SMTP_PASSWORD=

# Mailgun — production
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_ENCRYPTION=tls
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# Storage -> public | s3
STORAGE_DRIVER=s3

# AWS S3
# Buckets per environment:
#   testing:    base-portal-testing
#   staging:    base-portal-staging
#   production: base-portal-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=base-portal-testing
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Auth
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60

# Stripe — use test keys for local development, live keys for production
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET=sk_test_YOUR_SECRET_KEY_HERE
# Get your webhook secret by running: stripe listen --forward-to localhost/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_test

# Calendly — get your Personal Access Token at https://calendly.com/integrations/api_webhooks
CALENDLY_API_TOKEN=

# ─── Emails Queue ──────────────────────────────────────────────────────────
QUEUE_EMAIL_RATE_LIMIT=10
QUEUE_EMAIL_THROTTLE_DELAY=5

# ─── Websocket ─────────────────────────────────────────────────────────────
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" of type "Web application"
# 3. Under "Authorized JavaScript origins" add:
#      http://localhost:8000          (local API)
#      https://your-api.com           (production API)
# 4. Under "Authorized redirect URIs" add:
#      http://localhost:8000/api/auth/google/callback   (local)
#      https://your-api.com/api/auth/google/callback    (production)
# 5. Copy the Client ID and Client Secret below
