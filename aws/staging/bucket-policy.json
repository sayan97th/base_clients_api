{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPublicAssets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::base-portal-staging/news/*",
        "arn:aws:s3:::base-portal-staging/organizations/*",
        "arn:aws:s3:::base-portal-staging/profile-photos/*",
        "arn:aws:s3:::base-portal-staging/users/*",
        "arn:aws:s3:::base-portal-staging/resources/*"
      ]
    }
  ]
}
