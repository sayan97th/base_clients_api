{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BasePortalTestingFullAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:HeadObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::base-portal-testing",
        "arn:aws:s3:::base-portal-testing/*"
      ]
    }
  ]
}
